<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.photographer.focusstack</groupId>
    <artifactId>canon-focus-stack-parent</artifactId>
    <version>0.1.5-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Photographer - Parent</name>
    <description>Modular camera automation, focus stacking and clean-room Canon CR3 tooling</description>
    <url>https://github.com/carstenartur/Photographer</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>carstenartur</id>
            <name>Carsten Hammer</name>
            <url>https://github.com/carstenartur</url>
            <roles>
                <role>developer</role>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/carstenartur/Photographer.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/carstenartur/Photographer.git</developerConnection>
        <url>https://github.com/carstenartur/Photographer</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/carstenartur/Photographer/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/carstenartur/Photographer/actions</url>
    </ciManagement>

    <modules>
        <module>common-api</module>
        <module>plugin-api</module>
        <module>capture-core</module>
        <module>storage</module>
        <module>camera-ptp</module>
        <module>hdr-core</module>
        <module>video-core</module>
        <module>face-analysis-core</module>
        <module>face-profile-core</module>
        <module>session-core</module>
        <module>observer-core</module>
        <module>ai-vision</module>
        <module>astro-core</module>
        <module>canon-cr3-container</module>
        <module>canon-cr3-metadata</module>
        <module>canon-cr3-codec</module>
        <module>canon-cr3-processing</module>
        <module>canon-cr3-core</module>
        <module>canon-cr3-reference-testkit</module>
        <module>canon-cr3-research</module>
        <module>canon-cr3-imageio</module>
        <module>canon-cr3-maven-smoke</module>
        <module>canon-cr3-cli</module>
        <module>frontend-web</module>
        <module>app</module>
    </modules>

    <properties>
        <revision>0.1.5-SNAPSHOT</revision>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <cr3.java.version>21</cr3.java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <hibernate-search.version>8.4.1.Final</hibernate-search.version>
        <hibernate.version>7.4.0.Final</hibernate.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <springdoc.version>3.2.0</springdoc.version>
        <imagej.version>1.54j</imagej.version>
        <picocli.version>4.7.7</picocli.version>
        <jacoco.version>0.8.16</jacoco.version>
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <central.skipPublishing>true</central.skipPublishing>
        <cr3.attachTestJars>true</cr3.attachTestJars>
        <!-- Empty default so JaCoCo prepare-agent can inject its agent via late-binding @{argLine} -->
        <argLine/>
        <!-- Tags excluded by default; override with -DexcludedGroups= to run real-camera tests -->
        <excludedGroups>docker,real-camera</excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.hibernate.search</groupId>
                <artifactId>hibernate-search-mapper-orm</artifactId>
                <version>${hibernate-search.version}</version>
            </dependency>
            <dependency>
                <groupId>org.hibernate.search</groupId>
                <artifactId>hibernate-search-backend-lucene</artifactId>
                <version>${hibernate-search.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>net.imagej</groupId>
                <artifactId>ij</artifactId>
                <version>${imagej.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Xmx512m -Djava.awt.headless=true --enable-native-access=ALL-UNNAMED @{argLine}</argLine>
                        <excludedGroups>${excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <argLine>-Xmx4g -Djava.awt.headless=true --enable-native-access=ALL-UNNAMED @{argLine}</argLine>
                        <excludedGroups>${excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            JMH micro-benchmarks are isolated in this profile to keep the
            default reactor build fast. Activate with: mvn -P benchmarks ...
        -->
        <profile>
            <id>benchmarks</id>
            <modules>
                <module>canon-cr3-benchmark</module>
                <module>astro-core-benchmark</module>
            </modules>
        </profile>

        <!--
            Produces the consumer-facing Maven Central artifacts. The dedicated
            release aggregator selects only the supported CR3 runtime modules;
            this inherited profile supplies their publication configuration,
            flattens the internal parent relationship, attaches sources/Javadoc
            and signs every deployable file.
        -->
        <profile>
            <id>central-release</id>
            <properties>
                <central.skipUpload>true</central.skipUpload>
                <central.autoPublish>false</central.autoPublish>
                <central.waitUntil>validated</central.waitUntil>
                <cr3.attachTestJars>false</cr3.attachTestJars>
                <project.build.outputTimestamp>2026-11-14T00:00:00Z</project.build.outputTimestamp>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>include-cr3-license</id>
                                <goals><goal>add-resource</goal></goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/..</directory>
                                            <includes><include>LICENSE</include></includes>
                                            <targetPath>META-INF/cr3</targetPath>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>include-cr3-javadoc-resources</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/reports/apidocs</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.outputDirectory}/META-INF/cr3</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-public-release</id>
                                <phase>validate</phase>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <skip>${central.skipPublishing}</skip>
                                    <rules>
                                        <requireMavenVersion><version>[3.9,4)</version></requireMavenVersion>
                                        <requireReleaseVersion>
                                            <failWhenParentIsSnapshot>false</failWhenParentIsSnapshot>
                                        </requireReleaseVersion>
                                        <requireReleaseDeps>
                                            <failWhenParentIsSnapshot>false</failWhenParentIsSnapshot>
                                        </requireReleaseDeps>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <skipUpload>${central.skipUpload}</skipUpload>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>${central.waitUntil}</waitUntil>
                            <skipPublishing>${central.skipPublishing}</skipPublishing>
                            <deploymentName>Photographer CR3 ${revision}</deploymentName>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>${flatten-maven-plugin.version}</version>
                        <configuration>
                            <flattenedPomFilename>target/.flattened-pom.xml</flattenedPomFilename>
                            <flattenMode>oss</flattenMode>
                            <flattenDependencyMode>inherited</flattenDependencyMode>
                            <updatePomFile>true</updatePomFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten-public-pom</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>clean-flattened-public-pom</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-public-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <doclint>all</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-public-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                            <skip>${central.skipPublishing}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-public-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
