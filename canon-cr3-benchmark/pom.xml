<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.photographer.focusstack</groupId>
        <artifactId>canon-focus-stack-parent</artifactId>
        <version>0.1.6</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>canon-cr3-benchmark</artifactId>
    <version>0.1.6</version>

    <name>Canon CR3 - JMH Benchmarks</name>
    <description>JMH benchmarks for the Canon CR3 parser, metadata reader, preview extractor, CRX RAW decoder,
        RAW processing stages and complete ImageIO import. Mirrors the carstenartur/sandbox/sandbox-benchmarks
        pattern: shaded uber-jar with org.openjdk.jmh.Main as Main-Class, results consumed by
        benchmark-action/github-action-benchmark in the benchmark.yml workflow.</description>

    <properties>
        <jmh.version>1.37</jmh.version>
        <uberjar.name>benchmarks</uberjar.name>
        <benchmark.multiRelease>false</benchmark.multiRelease>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-container</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-metadata</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-codec</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-processing</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-imageio</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${uberjar.name}</finalName>
                            <transformers combine.self="override">
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>${benchmark.multiRelease}</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                            <filters combine.self="override">
                                <filter>
                                    <!-- Strip signatures from signed dependencies so the uber-jar
                                         can be executed without SecurityException. -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>cr3-vector</id>
            <properties>
                <benchmark.multiRelease>true</benchmark.multiRelease>
            </properties>
        </profile>
    </profiles>
</project>
