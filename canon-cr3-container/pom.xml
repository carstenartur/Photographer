<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.photographer.focusstack</groupId>
        <artifactId>canon-focus-stack-parent</artifactId>
        <version>0.1.5-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.github.carstenartur</groupId>
    <artifactId>cr3-container</artifactId>
    <version>${revision}</version>

    <name>CR3 Container</name>
    <description>ISO BMFF / Canon CR3 container parsing and embedded JPEG payload access</description>
    <url>https://github.com/carstenartur/Photographer</url>

    <scm>
        <connection>scm:git:https://github.com/carstenartur/Photographer.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/carstenartur/Photographer.git</developerConnection>
        <url>https://github.com/carstenartur/Photographer</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/carstenartur/Photographer/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/carstenartur/Photographer/actions</url>
    </ciManagement>

    <properties>
        <java.version>${cr3.java.version}</java.version>
        <central.skipPublishing>false</central.skipPublishing>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Sibling tests depend on this fixture jar. Install it locally
                 without attaching it to the public component for signing or deployment. -->
            <plugin>
                <artifactId>maven-install-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install-local-test-fixtures</id>
                        <phase>${cr3.fixtureInstallPhase}</phase>
                        <goals><goal>install-file</goal></goals>
                        <configuration>
                            <file>${project.build.directory}/${project.build.finalName}-tests.jar</file>
                            <pomFile>${project.file}</pomFile>
                            <classifier>tests</classifier>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <configuration>
                            <attach>${cr3.attachTestJars}</attach>
                        </configuration>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
