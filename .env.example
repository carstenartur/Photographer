# PostgreSQL
POSTGRES_DB=focusstack
POSTGRES_USER=focusstack
# Choose a unique password before the first database start.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Application
APP_PORT=8080
CAMERA_MOCK_ENABLED=true

# Security — required (startup fails if unset or left on insecure defaults like "focusstack"/"changeme")
FOCUSSTACK_SECURITY_ADMIN_PASSWORD=

# Spring
SPRING_PROFILES_ACTIVE=docker
