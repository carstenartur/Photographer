# PostgreSQL
POSTGRES_DB=focusstack
POSTGRES_USER=focusstack
POSTGRES_PASSWORD=focusstack
POSTGRES_PORT=5432

# Application
APP_PORT=8080
CAMERA_MOCK_ENABLED=true

# Security — REQUIRED: set a strong password before starting
FOCUSSTACK_SECURITY_ADMIN_PASSWORD=change-me-before-production

# Spring
SPRING_PROFILES_ACTIVE=docker
