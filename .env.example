# PostgreSQL
POSTGRES_DB=focusstack
POSTGRES_USER=focusstack
POSTGRES_PASSWORD=focusstack
POSTGRES_PORT=5432

# Application
APP_PORT=8080
CAMERA_MOCK_ENABLED=true

# Security — change this to a strong password before deploying to production
FOCUSSTACK_SECURITY_ADMIN_PASSWORD=focusstack

# Spring
SPRING_PROFILES_ACTIVE=docker
