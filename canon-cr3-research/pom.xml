<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.photographer.focusstack</groupId>
        <artifactId>canon-focus-stack-parent</artifactId>
        <version>0.1.6</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>canon-cr3-research</artifactId>
    <version>0.1.6</version>

    <name>Canon CR3 - Research</name>
    <description>Clean-room reverse-engineering experiments and reference-backed CR3 diagnostics</description>

    <dependencies>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-codec</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.photographer.focusstack</groupId>
            <artifactId>canon-cr3-reference-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-core</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-container</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}/canon-cr3-imageio/src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}/canon-cr3-imageio</workingDirectory>
                    <systemPropertyVariables>
                        <cr3.samples.dir>${maven.multiModuleProjectDirectory}/canon-cr3-imageio/src/test/resources/samples</cr3.samples.dir>
                        <cr3.research.output.dir>${project.build.directory}</cr3.research.output.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>cr3-research-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/canon-cr3-imageio</workingDirectory>
                            <systemPropertyVariables>
                                <cr3.samples.dir>${maven.multiModuleProjectDirectory}/canon-cr3-imageio/src/test/resources/samples</cr3.samples.dir>
                                <cr3.research.output.dir>${project.build.directory}</cr3.research.output.dir>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
