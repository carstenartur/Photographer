<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.photographer.focusstack</groupId>
        <artifactId>canon-focus-stack-parent</artifactId>
        <version>0.1.5</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.github.carstenartur</groupId>
    <artifactId>cr3-core</artifactId>
    <version>${revision}</version>

    <name>CR3 Core</name>
    <description>CR3 decode orchestration and compatibility facade</description>
    <url>https://github.com/carstenartur/Photographer</url>

    <scm>
        <connection>scm:git:https://github.com/carstenartur/Photographer.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/carstenartur/Photographer.git</developerConnection>
        <url>https://github.com/carstenartur/Photographer</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/carstenartur/Photographer/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/carstenartur/Photographer/actions</url>
    </ciManagement>

    <properties>
        <central.skipPublishing>false</central.skipPublishing>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-container</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-metadata</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-codec</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-processing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.carstenartur</groupId>
            <artifactId>cr3-container</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../docs/cr3</directory>
                <includes>
                    <include>import.md</include>
                </includes>
                <targetPath>META-INF/cr3</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <configuration>
                            <attach>${cr3.attachTestJars}</attach>
                        </configuration>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
