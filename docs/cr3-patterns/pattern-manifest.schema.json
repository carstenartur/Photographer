{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carstenartur/Photographer/docs/cr3-patterns/pattern-manifest.schema.json",
  "title": "CR3 D14 diagnostic pattern manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "issue",
    "activeRegionNormalizedBottomLeft",
    "borderLuminance",
    "captureRepeatsRequired",
    "grayCode",
    "patterns"
  ],
  "properties": {
    "schema": {"const": "pattern-manifest-v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "issue": {"type": "integer", "minimum": 1},
    "borderLuminance": {"type": "number", "minimum": 0, "maximum": 1},
    "captureRepeatsRequired": {"type": "integer", "minimum": 2},
    "activeRegionNormalizedBottomLeft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "grayCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "bitOrder", "xCells", "xBits", "yCells", "yBits"],
      "properties": {
        "encoding": {"type": "string", "minLength": 1},
        "bitOrder": {"type": "string", "minLength": 1},
        "xCells": {"type": "integer", "minimum": 2},
        "xBits": {"type": "integer", "minimum": 1},
        "yCells": {"type": "integer", "minimum": 2},
        "yBits": {"type": "integer", "minimum": 1}
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "page", "title", "parameters", "discriminator"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "family": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 2},
          "title": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "discriminator": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
