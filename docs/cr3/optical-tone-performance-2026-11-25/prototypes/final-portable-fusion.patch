+package com.photographer.focusstack.cr3.processing;
+
+import org.junit.jupiter.api.Test;
+
+import java.awt.Transparency;
+import java.awt.color.ColorSpace;
+import java.awt.image.BandedSampleModel;
+import java.awt.image.BufferedImage;
+import java.awt.image.ComponentColorModel;
+import java.awt.image.DataBuffer;
+import java.awt.image.DataBufferUShort;
+import java.awt.image.Raster;
+import java.util.Arrays;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class OpticalToneFusionTest {
+    private static final String G5 = "Canon PowerShot G5 X Mark II";
+    private static final OpticalCorrection IDENTITY = new OpticalCorrection(0, 0, 0, 1, 1, 0, 0, 0);
+    private static final OpticalCorrection LENS = new OpticalCorrection(.03, -.12, .02, 1.001, .999, -.6, .05, -.01);
+
+    @Test
+    void matchesSequentialCorrectionAcrossLayoutsAndWorkerCounts() {
+        for (Layout layout : Layout.values()) {
+            for (int workers : new int[]{1, 4}) {
+                compare(layout, 79, 61, true, workers, G5, 0x85);
+            }
+        }
+        // More than 256K pixels; up to three stripes with boundaries off the tile grid.
+        for (Layout layout : new Layout[]{Layout.DENSE16, Layout.PERMUTED16}) {
+            for (int workers : new int[]{1, 4}) {
+                compare(layout, 1024, 773, true, workers, G5, 0x85);
+            }
+        }
+    }
+
+    @Test
+    void leavesLinearLightToneDisabled() {
+        compare(Layout.DENSE16, 79, 61, false, 4, G5, 0x85);
+    }
+
+    @Test
+    void metadataSelectsTheSameSupportedAndUnsupportedTonePaths() {
+        String[] cameras = {null, "Unprofiled camera", G5, "Canon EOS R", "Canon EOS R"};
+        int[] styles = {0x85, 0x85, -1, 0x81, 0x86};
+        for (int i = 0; i < cameras.length; i++) {
+            compare(Layout.PERMUTED16, 31, 33, true, 4, cameras[i], styles[i]);
+        }
+    }
+
+    @Test
+    void identityAndSinglePixelFallbackApplyToneExactlyOnce() {
+        assertToneOnce(IDENTITY, 31, 33);
+        assertToneOnce(IDENTITY, 1, 1);
+        assertToneOnce(LENS, 1, 1);
+    }
+
+    @Test
+    void rejectsInvalidStrengthWorkersAndSampleLayout() {
+        for (double strength : new double[]{Double.NaN, -.1, 1.1, Double.POSITIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> LENS.applyToOwnedAndTone(
+                    fixture(Layout.DENSE16, 7, 5, true).image(), true, 1, strength, G5, 0x85));
+        }
+        assertThrows(IllegalArgumentException.class, () -> LENS.applyToOwnedAndTone(
+                fixture(Layout.DENSE16, 7, 5, true).image(), true, -1, 1, G5, 0x85));
+        assertThrows(IllegalArgumentException.class, () -> LENS.applyToOwnedAndTone(
+                new BufferedImage(7, 5, BufferedImage.TYPE_USHORT_GRAY), true, 1, 1, G5, 0x85));
+    }
+
+    @Test
+    void incompatibleColorSpaceStillFailsAfterTheSameOpticalMutation() {
+        var expected = fixture(Layout.DENSE16, 31, 33, false).image();
+        var actual = fixture(Layout.DENSE16, 31, 33, false).image();
+        LENS.applyToOwned(expected, true, 1, .35);
+        assertThrows(IllegalArgumentException.class, () -> CameraToneCurve.apply(expected, G5, 0x85, 1));
+        assertThrows(IllegalArgumentException.class,
+                () -> LENS.applyToOwnedAndTone(actual, true, 1, .35, G5, 0x85));
+        assertPixels(expected, actual, "optics before rejected tone");
+    }
+
+    private static void compare(Layout layout, int width, int height, boolean srgb, int workers,
+                                String camera, int style) {
+        Fixture expected = fixture(layout, width, height, srgb);
+        Fixture candidate = fixture(layout, width, height, srgb);
+        var raster = candidate.image().getRaster();
+        var model = candidate.image().getColorModel();
+        short[][] before = Pixels.denseRgb16Bands(candidate.image());
+        LENS.applyToOwned(expected.image(), srgb, workers, .35);
+        if (srgb) CameraToneCurve.apply(expected.image(), camera, style, workers);
+
+        var actual = LENS.applyToOwnedAndTone(candidate.image(), srgb, workers, .35, camera, style);
+        String label = layout + ", " + width + "x" + height + ", workers=" + workers
+                + ", srgb=" + srgb + ", camera=" + camera + ", style=" + style;
+        assertSame(candidate.image(), actual, label);
+        assertSame(raster, actual.getRaster(), label);
+        assertSame(model, actual.getColorModel(), label);
+        assertPixels(expected.image(), actual, label);
+        if (before != null) {
+            short[][] after = Pixels.denseRgb16Bands(actual);
+            assertNotNull(after, label);
+            for (int band = 0; band < 3; band++) assertSame(before[band], after[band], label);
+        }
+        if (expected.parent() != null) {
+            assertPixels(expected.parent(), candidate.parent(), label + ", including untouched borders");
+        }
+        if (layout == Layout.PADDED16) {
+            var expectedData = (DataBufferUShort) expected.image().getRaster().getDataBuffer();
+            var actualData = (DataBufferUShort) actual.getRaster().getDataBuffer();
+            for (int band = 0; band < 3; band++) {
+                assertArrayEquals(expectedData.getData(band), actualData.getData(band), label + ", padding");
+            }
+        }
+    }
+
+    private static void assertToneOnce(OpticalCorrection correction, int width, int height) {
+        var expected = fixture(Layout.DENSE16, width, height, true).image();
+        var actual = fixture(Layout.DENSE16, width, height, true).image();
+        int[] input = {10000, 17000, 23000};
+        expected.getRaster().setPixel(0, 0, input);
+        actual.getRaster().setPixel(0, 0, input);
+        assertTrue(CameraToneCurve.apply(expected, G5, 0x85, 4));
+        int[] once = expected.getRaster().getPixel(0, 0, (int[]) null);
+        assertFalse(Arrays.equals(input, once), "The fixture must detect missing tone");
+        assertSame(actual, correction.applyToOwnedAndTone(actual, true, 4, 1, G5, 0x85));
+        assertPixels(expected, actual, "tone exactly once after optical early return");
+        CameraToneCurve.apply(expected, G5, 0x85, 4);
+        assertFalse(Arrays.equals(once, expected.getRaster().getPixel(0, 0, (int[]) null)),
+                "The fixture must detect repeated tone");
+    }
+
+    private enum Layout {
+        DENSE16, PERMUTED16, INTERLEAVED16, TRANSLATED16, PADDED16,
+        PACKED8, INTERLEAVED8, TRANSLATED8
+    }
+
+    private record Fixture(BufferedImage image, BufferedImage parent) {}
+
+    private static Fixture fixture(Layout layout, int width, int height, boolean srgb) {
+        boolean eight = layout == Layout.PACKED8 || layout == Layout.INTERLEAVED8 || layout == Layout.TRANSLATED8;
+        var space = ColorSpace.getInstance(srgb ? ColorSpace.CS_sRGB : ColorSpace.CS_LINEAR_RGB);
+        var model = new ComponentColorModel(space, false, false, Transparency.OPAQUE,
+                eight ? DataBuffer.TYPE_BYTE : DataBuffer.TYPE_USHORT);
+        BufferedImage parent = null;
+        BufferedImage image;
+        switch (layout) {
+            case PACKED8 -> image = new BufferedImage(width, height, BufferedImage.TYPE_INT_RGB);
+            case INTERLEAVED8, INTERLEAVED16 -> image = new BufferedImage(model,
+                    model.createCompatibleWritableRaster(width, height), false, null);
+            case TRANSLATED8, TRANSLATED16 -> {
+                parent = new BufferedImage(model, model.createCompatibleWritableRaster(width + 11, height + 9),
+                        false, null);
+                fill(parent);
+                image = parent.getSubimage(5, 3, width, height);
+            }
+            case PADDED16 -> {
+                int stride = width + 5;
+                var samples = new BandedSampleModel(DataBuffer.TYPE_USHORT, width, height, stride,
+                        new int[]{0, 1, 2}, new int[3]);
+                var data = new DataBufferUShort(new short[3][stride * height], stride * height);
+                image = new BufferedImage(model, Raster.createWritableRaster(samples, data, null), false, null);
+            }
+            default -> {
+                int[] indices = layout == Layout.PERMUTED16 ? new int[]{2, 0, 1} : new int[]{0, 1, 2};
+                var data = new DataBufferUShort(new short[3][width * height], width * height);
+                image = new BufferedImage(model, Raster.createBandedRaster(data, width, height, width,
+                        indices, new int[3], null), false, null);
+            }
+        }
+        fill(image);
+        return new Fixture(image, parent);
+    }
+
+    private static void fill(BufferedImage image) {
+        int maximum = image.getSampleModel().getSampleSize(0) == 8 ? 255 : 65535;
+        int[] pixel = new int[3];
+        for (int y = 0; y < image.getHeight(); y++) {
+            for (int x = 0; x < image.getWidth(); x++) {
+                for (int band = 0; band < 3; band++) {
+                    int value = (x * 1451 + y * 2539 + band * 7919 + x * y * 17) & maximum;
+                    if ((x + y + band) % 31 == 0) value = 0;
+                    if ((x + 3 * y + band) % 37 == 0) value = maximum;
+                    pixel[band] = value;
+                }
+                image.getRaster().setPixel(x, y, pixel);
+            }
+        }
+    }
+
+    private static void assertPixels(BufferedImage expected, BufferedImage actual, String label) {
+        assertEquals(expected.getWidth(), actual.getWidth(), label);
+        assertEquals(expected.getHeight(), actual.getHeight(), label);
+        assertEquals(expected.getColorModel(), actual.getColorModel(), label);
+        int[] expectedRow = new int[expected.getWidth() * 3];
+        int[] actualRow = new int[expectedRow.length];
+        for (int y = 0; y < expected.getHeight(); y++) {
+            expected.getRaster().getPixels(0, y, expected.getWidth(), 1, expectedRow);
+            actual.getRaster().getPixels(0, y, actual.getWidth(), 1, actualRow);
+            assertArrayEquals(expectedRow, actualRow, label + ", row " + y);
+        }
+    }
+}
