 class CrxWaveletDetailTest {
+    // A zero run flag, 41 zero quotient bits plus its terminator, then a 21-bit literal.
+    // The guard adds one to that literal before signed mapping. The second coefficient is zero.
+    private static final byte[] POSITIVE_LIMIT = HexFormat.of().parseHex("00000000003fffff80");
+    private static final byte[] NEGATIVE_LIMIT = HexFormat.of().parseHex("00000000003ffffe80");
+
+    @Test
+    void dequantizesTheGuardedSignedCoefficientLimitsAcrossTheBoundedFactorRange() throws IOException {
+        int[][] cases = {{0, 0}, {1, 1048576}, {4, 4194304}, {63, 66060288}, {64, 67108864}};
+        for (int[] sample : cases) {
+            int factor = sample[0];
+            int expanded = sample[1];
+            assertThat(decode(POSITIVE_LIMIT, 0, POSITIVE_LIMIT.length, 2, 1, factor))
+                    .containsExactly(expanded, 0);
+            assertThat(decode(NEGATIVE_LIMIT, 0, NEGATIVE_LIMIT.length, 2, 1, factor))
+                    .containsExactly(-expanded, 0);
+        }
+        // Without a run flag the largest positive signed value is one smaller.
+        byte[] unguarded = HexFormat.of().parseHex("00000000007ffffc");
+        assertThat(decode(unguarded, 0, unguarded.length, 1, 1, 64)).containsExactly(67108800);
+    }
+
+    @Test
+    void largerFactorsKeepCheckedIntegerBoundariesAndRejectBothOverflowSigns() throws IOException {
+        assertThat(decode(POSITIVE_LIMIT, 0, POSITIVE_LIMIT.length, 2, 1, 65))
+                .containsExactly(68157440, 0);
+        assertThat(decode(NEGATIVE_LIMIT, 0, NEGATIVE_LIMIT.length, 2, 1, 65))
+                .containsExactly(-68157440, 0);
+        assertThat(decode(POSITIVE_LIMIT, 0, POSITIVE_LIMIT.length, 2, 1, 2047))
+                .containsExactly(2146435072, 0);
+        assertThat(decode(NEGATIVE_LIMIT, 0, NEGATIVE_LIMIT.length, 2, 1, 2048))
+                .containsExactly(Integer.MIN_VALUE, 0);
+        assertThat(decode(new byte[]{0x20}, 0, 1, 1, 1, Integer.MAX_VALUE)).containsExactly(Integer.MAX_VALUE);
+        assertThat(decode(new byte[]{0x40}, 0, 1, 1, 1, Integer.MAX_VALUE)).containsExactly(-Integer.MAX_VALUE);
+        assertThat(decode(new byte[]{(byte) 0x80}, 0, 1, 1, 1, Integer.MAX_VALUE)).containsExactly(0);
+
+        assertThatThrownBy(() -> decode(POSITIVE_LIMIT, 0, POSITIVE_LIMIT.length, 2, 1, 2048))
+                .isInstanceOf(IOException.class).hasMessageContaining("coefficient");
+        assertThatThrownBy(() -> decode(NEGATIVE_LIMIT, 0, NEGATIVE_LIMIT.length, 2, 1, 2049))
+                .isInstanceOf(IOException.class).hasMessageContaining("coefficient");
+    }
