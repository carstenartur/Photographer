+    // The first six bits of a non-escape Rice code distinguish quotients 0, 1–2, 3–5
+    // and 6 or greater. For quotient zero its second bit is the top remainder bit.
+    private static final byte[] NEXT_DETAIL_WIDTH = nextDetailWidths();
+
+    private static byte[] nextDetailWidths() {
+        byte[] widths = new byte[(CrxEntropyState.MAX_RICE_WIDTH + 1) << 6];
+        for (int k = 0; k <= CrxEntropyState.MAX_RICE_WIDTH; k++) {
+            for (int prefix = 0; prefix < 64; prefix++) {
+                int delta;
+                if (prefix == 0) {
+                    delta = 2;
+                } else if (prefix < 8) {
+                    delta = 1;
+                } else if (prefix >= 32 && prefix < 48) {
+                    delta = -1;
+                } else {
+                    delta = 0;
+                }
+                widths[(k << 6) | prefix] = (byte) Math.clamp(k + delta, 0, CrxEntropyState.MAX_RICE_WIDTH);
+            }
+        }
+        return widths;
+    }
