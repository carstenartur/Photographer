+    private static short[] detailPrefixes() {
+        int count = 1 << DETAIL_PREFIX_BITS;
+        short[] table = new short[2 * SMALL_RICE_WIDTHS * count];
+        for (int guard = 0; guard <= 1; guard++) {
+            for (int k = 0; k < SMALL_RICE_WIDTHS; k++) {
+                for (int prefix = 0; prefix < count; prefix++) {
+                    int word = prefix << (Integer.SIZE - DETAIL_PREFIX_BITS);
+                    int leading = Integer.numberOfLeadingZeros(word);
+                    int quotient = leading - guard;
+                    int length = leading + 1 + k;
+                    int index = ((guard * SMALL_RICE_WIDTHS + k) << DETAIL_PREFIX_BITS) | prefix;
+                    if (quotient < 0) {
+                        table[index] = (POSITIVE_RUN << 4) | 1;
+                    } else if (length <= DETAIL_PREFIX_BITS) {
+                        int remainder = (word >>> (Integer.SIZE - length)) & ((1 << k) - 1);
+                        int code = CrxEntropyState.packDetailCode(k, (quotient << k) + remainder, quotient);
+                        table[index] = (short) ((code << 4) | length);
+                    }
+                }
+            }
+        }
+        return table;
+    }
