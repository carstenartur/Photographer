+    /**
+     * Applies the existing eight-bit matrix and sRGB gamma passes in place.
+     *
+     * @param image the RGB image to modify
+     * @param matrix 3×3 color correction matrix
+     */
+    public static void processAndConvertToSrgb(BufferedImage image, double[][] matrix) {
+        processAndConvertToSrgb(image, matrix, 1);
+    }
+
+    /**
+     * Combines scalar matrix and gamma processing on disjoint packed RGB pixels.
+     * The matrix is truncated and clipped before the existing eight-bit gamma
+     * lookup. Other rasters retain both color-model round trips, and an available
+     * vector matrix kernel retains its separate gamma pass.
+     *
+     * @param image the RGB image to modify
+     * @param matrix 3×3 color correction matrix
+     * @param maxWorkers maximum number of workers, or zero for automatic selection
+     */
+    public static void processAndConvertToSrgb(BufferedImage image, double[][] matrix, int maxWorkers) {
+        if (matrix.length != 3 || matrix[0].length != 3) {
+            throw new IllegalArgumentException("Color matrix must be 3x3");
+        }
+
+        int width = image.getWidth();
+        Pixels.Packed packed = Pixels.packed(image);
+        if (packed == null || packed.stride() < width) {
+            // A storage/color-model round trip can change the matrix result.
+            // Aliased rows also require the original order of complete passes.
+            process(image, matrix, maxWorkers);
+            SrgbConverter.process(image, maxWorkers);
+            return;
+        }
+        if (processWithVectors(image, matrix, maxWorkers)) {
+            SrgbConverter.process(image, maxWorkers);
+            return;
+        }
+
+        LOG.debug("Applying 3x3 color matrix and sRGB gamma to {}x{} image", width, image.getHeight());
+        Pixels.transformPacked(packed, width, image.getHeight(), maxWorkers, (pixels, offset) -> {
+            for (int i = offset; i < offset + width; i++) {
+                pixels[i] = SrgbConverter.applyGamma(applyMatrix(pixels[i], matrix));
+            }
+        });
+    }
+
     static boolean processWithVectors(BufferedImage image, double[][] matrix, int maxWorkers) {
         VectorKernel kernel = VectorSupport.KERNEL;
         return kernel != null && kernel.process(image, matrix, maxWorkers);
