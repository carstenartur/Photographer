+package com.photographer.focusstack.cr3.processing;
+
+import org.junit.jupiter.api.Test;
+
+import java.awt.color.ColorSpace;
+import java.awt.image.BufferedImage;
+import java.awt.image.DataBuffer;
+import java.awt.image.DataBufferByte;
+import java.awt.image.DataBufferInt;
+import java.awt.image.DirectColorModel;
+import java.awt.image.Raster;
+import java.util.SplittableRandom;
+import java.util.function.Supplier;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+/** Keep the intermediate matrix quantization and raster round trips of the public APIs. */
+class ColorMatrixSrgbTest {
+    private static final int WIDTH = 47;
+    private static final int HEIGHT = 29;
+    private static final double[][] IDENTITY = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};
+    private static final double[][][] MATRICES = {
+            IDENTITY,
+            {{0.5, 0, 0}, {0, -1, 0}, {0, 0, 100}},
+            {{1.1250000000000002, -0.12499999999999999, 0.0001},
+                    {Double.MIN_VALUE, Math.nextDown(1.0), -0.0125}, {-0.75, 1.5, 0.8}},
+            {{Double.NaN, 0, 0}, {Double.POSITIVE_INFINITY, 0, 0},
+                    {Double.MAX_VALUE, -Double.MAX_VALUE, 0}},
+            {{1, 0, 0}, {0, 0, 1, 42}, {0, 1, 0}}
+    };
+
+    @Test
+    void matchesSeparatePassesForPackedParentsAndSubimages() {
+        for (int type : new int[]{BufferedImage.TYPE_INT_RGB, BufferedImage.TYPE_INT_ARGB}) {
+            checkMatrices(() -> new BufferedImage(WIDTH, HEIGHT, type), "type=" + type);
+        }
+        checkMatrices(() -> packedImage(WIDTH, HEIGHT, WIDTH + 7, ColorSpace.CS_sRGB),
+                "padded sRGB with buffer offset");
+    }
+
+    @Test
+    void retainsIntermediateRasterConversionsForGeneralColorModels() {
+        for (int type : new int[]{BufferedImage.TYPE_3BYTE_BGR, BufferedImage.TYPE_INT_ARGB_PRE,
+                BufferedImage.TYPE_INT_BGR}) {
+            checkMatrices(() -> new BufferedImage(WIDTH, HEIGHT, type), "fallback type=" + type);
+        }
+        checkMatrices(() -> packedImage(WIDTH, HEIGHT, WIDTH + 7, ColorSpace.CS_LINEAR_RGB),
+                "packed linear color model");
+    }
+
+    @Test
+    void retainsCompletePassOrderingForOverlappingPackedRows() {
+        assertNotNull(Pixels.packed(packedImage(WIDTH, HEIGHT, WIDTH - 11, ColorSpace.CS_sRGB)),
+                "The overlapping-row fixture must exercise the packed path");
+        checkMatrices(() -> packedImage(WIDTH, HEIGHT, WIDTH - 11, ColorSpace.CS_sRGB),
+                "overlapping packed rows");
+    }
+
+    @Test
+    void matchesSeparatePassesAcrossParallelStripesAndScalarTails() {
+        // A cropped width not divisible by four also exercises the optional vector tail.
+        assertMatchesSeparatePasses(
+                () -> new BufferedImage(1037, 523, BufferedImage.TYPE_INT_ARGB),
+                true, MATRICES[2], 3, "parallel ARGB crop");
+    }
+
+    @Test
+    void truncatesAndClipsMatrixBeforeGammaAndClearsTheStoredAlpha() {
+        var image = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        int[] storage = ((DataBufferInt) image.getRaster().getDataBuffer()).getData();
+        storage[0] = 0xff030305;
+
+        ColorMatrixProcessor.processAndConvertToSrgb(image, MATRICES[1]);
+
+        // Matrix: (1.5, -3, 500) -> int/clamp (1, 0, 255) -> gamma (13, 0, 255).
+        // Both existing passes discard the upper eight bits; retain that storage contract.
+        assertEquals(0x000d00ff, storage[0]);
+    }
+
+    @Test
+    void rejectsNegativeWorkerLimitAndInvalidMatrixBeforeWriting() {
+        var image = new BufferedImage(7, 5, BufferedImage.TYPE_INT_ARGB);
+        seed(image);
+        int[] before = ((DataBufferInt) image.getRaster().getDataBuffer()).getData().clone();
+
+        assertThrows(IllegalArgumentException.class,
+                () -> ColorMatrixProcessor.processAndConvertToSrgb(image, IDENTITY, -1));
+        assertArrayEquals(before, ((DataBufferInt) image.getRaster().getDataBuffer()).getData());
+        assertThrows(IllegalArgumentException.class,
+                () -> ColorMatrixProcessor.processAndConvertToSrgb(image, new double[][]{{1, 0}, {0, 1}}, 1));
+        assertArrayEquals(before, ((DataBufferInt) image.getRaster().getDataBuffer()).getData());
+    }
+
+    private static void checkMatrices(Supplier<BufferedImage> factory, String description) {
+        for (int matrix = 0; matrix < MATRICES.length; matrix++) {
+            assertMatchesSeparatePasses(factory, false, MATRICES[matrix], 1,
+                    description + ", full, matrix=" + matrix);
+            assertMatchesSeparatePasses(factory, true, MATRICES[matrix], 0,
+                    description + ", crop, matrix=" + matrix);
+        }
+    }
+
+    private static void assertMatchesSeparatePasses(Supplier<BufferedImage> factory, boolean crop,
+                                                    double[][] matrix, int workers, String description) {
+        BufferedImage expected = factory.get();
+        BufferedImage actual = factory.get();
+        seed(expected);
+        seed(actual);
+        BufferedImage expectedRegion = region(expected, crop);
+        BufferedImage actualRegion = region(actual, crop);
+
+        ColorMatrixProcessor.process(expectedRegion, matrix, workers);
+        SrgbConverter.process(expectedRegion, workers);
+        ColorMatrixProcessor.processAndConvertToSrgb(actualRegion, matrix, workers);
+
+        int width = expected.getWidth();
+        int height = expected.getHeight();
+        assertArrayEquals(expected.getRGB(0, 0, width, height, null, 0, width),
+                actual.getRGB(0, 0, width, height, null, 0, width), description);
+        assertStorageEquals(expected.getRaster().getDataBuffer(), actual.getRaster().getDataBuffer(), description);
+    }
+
+    private static BufferedImage region(BufferedImage image, boolean crop) {
+        return crop ? image.getSubimage(3, 2, image.getWidth() - 6, image.getHeight() - 4) : image;
+    }
+
+    private static BufferedImage packedImage(int width, int height, int stride, int colorSpace) {
+        int offset = 5;
+        int[] storage = new int[offset + (height - 1) * stride + width + 7];
+        var buffer = new DataBufferInt(storage, storage.length - offset, offset);
+        int[] masks = {0xff0000, 0xff00, 0xff};
+        var raster = Raster.createPackedRaster(buffer, width, height, stride, masks, null);
+        var model = new DirectColorModel(ColorSpace.getInstance(colorSpace), 24,
+                masks[0], masks[1], masks[2], 0, false, DataBuffer.TYPE_INT);
+        return new BufferedImage(model, raster, false, null);
+    }
+
+    private static void seed(BufferedImage image) {
+        var random = new SplittableRandom(0xa53b27d4);
+        DataBuffer storage = image.getRaster().getDataBuffer();
+        for (int bank = 0; bank < storage.getNumBanks(); bank++) {
+            for (int i = 0; i < storage.getSize(); i++) {
+                storage.setElem(bank, i, random.nextInt());
+            }
+        }
+        for (int y = 0; y < image.getHeight(); y++) {
+            for (int x = 0; x < image.getWidth(); x++) {
+                image.setRGB(x, y, random.nextInt());
+            }
+        }
+    }
+
+    private static void assertStorageEquals(DataBuffer expected, DataBuffer actual, String description) {
+        assertEquals(expected.getNumBanks(), actual.getNumBanks(), description);
+        for (int bank = 0; bank < expected.getNumBanks(); bank++) {
+            if (expected instanceof DataBufferInt ei && actual instanceof DataBufferInt ai) {
+                // Includes alpha, leading offsets, row padding and untouched parent pixels.
+                assertArrayEquals(ei.getData(bank), ai.getData(bank), description);
+            } else if (expected instanceof DataBufferByte eb && actual instanceof DataBufferByte ab) {
+                assertArrayEquals(eb.getData(bank), ab.getData(bank), description);
+            } else {
+                throw new AssertionError("Unhandled test buffer type: " + expected.getClass());
+            }
+        }
+    }
+}
